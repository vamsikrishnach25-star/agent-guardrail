# Copy this to .env (or .env.local) if you want `npm run dev` to talk to a
# backend other than http://localhost:8000 - e.g. the deployed Render
# backend, or a different port if 8000 is already in use.
#
# For a production build, this is instead baked in at build time via the
# Docker build arg of the same name (see frontend/Dockerfile and
# DEPLOYMENT.md step 3) - this file only affects local `npm run dev`.
VITE_API_URL=http://localhost:8000
